                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 8. Status test\r",
                  "pm.test(\"Successful creation (201)\", () => pm.response.to.have.status(201));\r",
                  "\r",
                  "// 9. Schema test\r",
                  "pm.test(\"Has ID in response\", () => {\r",
                  "    pm.expect(pm.response.json()).to.have.property('id');\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
