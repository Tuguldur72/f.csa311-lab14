        {
          "name": "Get Post by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 5. Status test\r",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r",
                  "\r",
                  "// 6. Header test\r",
                  "pm.test(\"Content-Type is JSON\", () => {\r",
                  "    // Header дотор 'application/json' гэсэн бичиг байгаа эсэхийг шалгах\r",
                  "    pm.response.to.have.header(\"Content-Type\");\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "// 7. Value test\r",
                  "pm.test(\"Chained ID matches\", () => {\r",
                  "    const id = pm.environment.get(\"firstPostId\");\r",
                  "    pm.expect(pm.response.json().id).to.eql(id);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{firstPostId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{firstPostId}}"
              ]
            },
            "description": "StartFragment\n\nӨмнөх хүсэлтээс авсан ID-г ашиглан нэг постын мэдээллийг авна.\n\nEndFragment"
